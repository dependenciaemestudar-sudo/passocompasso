  function renderTimer() { const timer = state.timer; const elapsed = currentElapsed(); const remaining = timer.duration ? Math.max(0, timer.duration - elapsed) : elapsed; const progress = timer.duration ? clamp(Math.round(elapsed / timer.duration * 100), 0, 100) : 0; const subject = getSubject(timer.subjectId); const status = timer.running ? 'Em foco agora' : elapsed > 0 ? 'Pausado · retome quando quiser' : timer.mode === 'break' ? 'Pausa curta' : 'Pronto para começar'; return `<section><div class="section-heading"><div><h2>Pomodoro e cronômetro</h2><p>Use timestamps para manter o tempo coerente quando a aba ficar em segundo plano. Fechar o dispositivo interrompe a contagem.</p></div></div><div class="timer-layout"><article class="card timer-card"><div class="segmented timer-modes"><button class="${timer.mode === 'focus' ? 'is-active' : ''}" data-action="timer-mode" data-mode="focus" type="button">Foco 25</button><button class="${timer.mode === 'break' ? 'is-active' : ''}" data-action="timer-mode" data-mode="break" type="button">Pausa 5</button><button class="${timer.mode === 'longBreak' ? 'is-active' : ''}" data-action="timer-mode" data-mode="longBreak" type="button">Pausa 15</button><button class="${timer.mode === 'free' ? 'is-active' : ''}" data-action="timer-mode" data-mode="free" type="button">Livre</button></div><div class="timer-display" id="timerDisplay">${timeLabel(remaining)}</div><div class="timer-state" id="timerState">${status}</div><div class="timer-subject">${subject ? escapeHtml(subject.name) : 'Sem matéria selecionada'}${timer.objective ? ` · ${escapeHtml(timer.objective)}` : ''}</div><div class="timer-progress"><div class="progress-line"><span id="timerProgress" style="width:${progress}%"></span></div></div><div class="timer-actions">${button(timer.running ? 'Pausar' : elapsed > 0 ? 'Continuar' : 'Iniciar', timer.running ? 'pause-timer' : 'start-timer', 'button-primary')}${button('Reiniciar', 'reset-timer', 'button-quiet')}${button('Finalizar', 'finish-timer', 'button-quiet')}</div><div class="session-summary"><div><strong>${timer.completedCycles}</strong><span>ciclos concluídos</span></div><div><strong>${minutesLabel(getTodaySessions().reduce((sum, item) => sum + item.minutes, 0))}</strong><span>hoje</span></div><div><strong>${getTodaySessions().length}</strong><span>sessões hoje</span></div></div></article><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">CONFIGURE O BLOCO</p><h3>Intenção da sessão</h3></div></div><form class="form-stack" id="timerForm"><div class="field"><label for="timerSubject">Matéria</label><select id="timerSubject" name="subjectId"><option value="">Sem matéria</option>${subjectOptions(timer.subjectId)}</select></div><div class="field"><label for="timerObjective">Objetivo</label><input id="timerObjective" name="objective" value="${escapeHtml(timer.objective || '')}" placeholder="Ex.: revisar ligações" maxlength="70" /></div><div class="field"><label for="customDuration">Duração personalizada (min)</label><input id="customDuration" name="customDuration" type="number" min="1" max="180" placeholder="25" /><span class="field-help">Use o modo Livre para contar sem meta de término.</span></div><button class="button button-primary" type="submit">Salvar intenção</button></form><div class="info-note" style="margin-top:18px"><strong>Sobre o registro:</strong> somente sessões finalizadas com pelo menos 1 minuto entram nas estatísticas e pontuação local.</div></article></div></section>`; }
  function currentElapsed() { const timer = state.timer; if (!timer.running || !timer.startedAt) return timer.elapsedBeforeStart || 0; return (timer.elapsedBeforeStart || 0) + Math.floor((Date.now() - timer.startedAt) / 1000); }
  function updateTimerDisplay() { const display = $('#timerDisplay'); if (!display) return; const timer = state.timer; const elapsed = currentElapsed(); const remaining = timer.duration ? Math.max(0, timer.duration - elapsed) : elapsed; display.textContent = timeLabel(remaining); const progress = timer.duration ? clamp(Math.round(elapsed / timer.duration * 100), 0, 100) : 0; const bar = $('#timerProgress'); if (bar) bar.style.width = `${progress}%`; const status = $('#timerState'); if (status) status.textContent = timer.running ? 'Em foco agora' : elapsed > 0 ? 'Pausado · retome quando quiser' : timer.mode === 'break' ? 'Pausa curta' : 'Pronto para começar'; if (timer.running && timer.duration && elapsed >= timer.duration) finishTimer(true); }
  function startTimer() { if (state.timer.running) return; state.timer.startedAt = Date.now(); state.timer.running = true; saveState(); startTimerTicker(); render(); toast('Sessão iniciada. Bom foco.'); }
  function pauseTimer() { if (!state.timer.running) return; state.timer.elapsedBeforeStart = currentElapsed(); state.timer.startedAt = null; state.timer.running = false; saveState(); stopTimerTicker(); render(); toast('Sessão pausada.'); }
  function resetTimer() { state.timer.running = false; state.timer.startedAt = null; state.timer.elapsedBeforeStart = 0; saveState(); stopTimerTicker(); render(); toast('Timer reiniciado.'); }
  function finishTimer(auto = false) { const elapsed = currentElapsed(); const minutes = Math.floor(elapsed / 60); state.timer.running = false; state.timer.startedAt = null; state.timer.elapsedBeforeStart = 0; if (minutes >= 1) { state.sessions.push({ id: uid('session'), date: todayKey(), subjectId: state.timer.subjectId || '', minutes, objective: state.timer.objective || '', mode: state.timer.mode }); if (state.timer.mode === 'focus') state.timer.completedCycles += 1; saveState(); toast(auto ? 'Bloco concluído e salvo no seu histórico.' : 'Sessão finalizada e adicionada às estatísticas.'); } else { saveState(); if (!auto) toast('Sessões com menos de 1 minuto não entram nas estatísticas.', 'warning'); } stopTimerTicker(); if (currentSection === 'timer') render(); }
  function startTimerTicker() { stopTimerTicker(); timerTicker = window.setInterval(updateTimerDisplay, 1000); }
  function stopTimerTicker() { if (timerTicker) window.clearInterval(timerTicker); timerTicker = null; }

  function renderPlanner() { const tasks = [...state.tasks].sort((a, b) => Number(a.done) - Number(b.done) || String(a.due).localeCompare(String(b.due))); return `<section><div class="section-heading"><div><h2>Planner</h2><p>Coloque no papel digital o que precisa acontecer. Prazos próximos aparecem primeiro nas recomendações.</p></div><div class="section-heading-actions">${button('Nova tarefa', 'open-task-modal', 'button-primary')}</div></div><div class="panel-grid wide"><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">LISTA</p><h3>Próximos passos</h3></div><span class="muted small">${state.tasks.filter(task => !task.done).length} abertos</span></div><div class="task-list">${tasks.length ? tasks.map(plannerTask).join('') : emptyState('Sua lista está vazia', 'Adicione uma tarefa, prova ou trabalho para começar.', 'Adicionar tarefa', 'open-task-modal')}</div></article><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">META DIÁRIA</p><h3>Hoje</h3></div></div><div class="quiz-score"><strong>${minutesLabel(getStudyMinutes(getTodaySessions()))}</strong><span class="muted small">de ${state.profile.dailyGoal} min registrados</span></div><div style="margin-top:15px"><div class="progress-line"><span style="width:${clamp(getStudyMinutes(getTodaySessions()) / state.profile.dailyGoal * 100, 0, 100)}%"></span></div></div><p class="muted small" style="margin:12px 0 0">${state.tasks.filter(task => !task.done && task.due === todayKey()).length} compromisso(s) para hoje.</p></article></div></section>`; }
  function plannerTask(task) { const date = parseDate(task.due); const soon = date && date <= new Date(Date.now() + 86400000 * 2); return `<div class="task-item ${task.done ? 'is-done' : ''}"><input class="task-checkbox" type="checkbox" ${task.done ? 'checked' : ''} data-action="toggle-task" data-task-id="${task.id}" aria-label="Marcar ${escapeHtml(task.title)} como concluída" /><div class="task-copy"><strong>${escapeHtml(task.title)}</strong><small><span class="priority ${task.priority}">${escapeHtml(task.priority)}</span> · ${escapeHtml(task.type)} · ${escapeHtml(getSubject(task.subjectId)?.name || 'Sem matéria')} · ${task.estimate || 0} min${task.example ? ' · exemplo editável' : ''}</small></div><span class="task-date ${soon && !task.done ? 'is-soon' : ''}">${formatDate(task.due)}</span><button type="button" class="button button-quiet button-small button-icon" data-action="delete-task" data-task-id="${task.id}" aria-label="Excluir ${escapeHtml(task.title)}">×</button></div>`; }

  function renderQuizzes() { if (quizSession) return renderQuizPlay(); const attempts = state.quizAttempts; return `<section><div class="section-heading"><div><h2>Desafios e quizzes</h2><p>Pratique sem transformar velocidade em prova de conhecimento. Os resultados são locais e servem para orientar sua próxima revisão.</p></div><div class="section-heading-actions">${button('Criar quiz local', 'open-quiz-modal', 'button-quiet')} ${button('Começar prática', 'start-quiz', 'button-primary')}</div></div><div class="quiz-grid"><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">DESAFIO DE HOJE</p><h3>Trilha de revisão</h3></div><span class="metric-icon violet">△</span></div><div class="challenge-card"><span class="metric-icon orange">◇</span><div><h3>${quizBank.length} perguntas de prática</h3><p>Química, matemática e história. Sem cronômetro e com explicação depois de cada resposta.</p></div></div><div class="challenge-card" style="margin-top:8px"><span class="metric-icon mint">✦</span><div><h3>Pontos por consistência</h3><p>Cada resposta correta vale pontos moderados. Participar já registra uma tentativa.</p></div></div><div class="info-note" style="margin-top:15px"><strong>Importante:</strong> uma pontuação alta indica desempenho nesta rodada, não domínio absoluto do conteúdo.</div></article><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">HISTÓRICO LOCAL</p><h3>Suas tentativas</h3></div></div>${attempts.length ? `<div class="list">${attempts.slice().reverse().slice(0, 5).map(attempt => `<div class="list-item"><div class="list-item-main"><span class="metric-icon mint">✓</span><div class="list-item-copy"><strong>${attempt.correct}/${attempt.total} corretas</strong><small>${formatDate(attempt.date)} · modo prática</small></div></div><span class="list-item-side text-mint">+${attempt.points} pts</span></div>`).join('')}</div>` : emptyState('Ainda sem tentativas', 'Comece uma prática de três perguntas para registrar seu primeiro resultado.', 'Começar prática', 'start-quiz')}</article></div></section>`; }
  function renderQuizPlay() { const question = quizBank[quizSession.index]; const answered = quizSession.answer !== null; return `<section><div class="section-heading"><div><p class="eyebrow">PRÁTICA LOCAL · ${quizSession.index + 1}/${quizBank.length}</p><h2>${escapeHtml(question.subject)}</h2><p>Sem cronômetro. Leia, responda e confira a explicação.</p></div>${button('Sair da prática', 'exit-quiz', 'button-quiet')}</div><article class="card card-pad" style="max-width:800px"><div class="progress-line"><span style="width:${Math.round((quizSession.index) / quizBank.length * 100)}%"></span></div><h3 class="quiz-question">${escapeHtml(question.question)}</h3><div class="list">${question.options.map((option, index) => `<button type="button" class="quiz-option ${answered && index === question.answer ? 'is-correct' : ''} ${answered && quizSession.answer === index && index !== question.answer ? 'is-wrong' : ''}" data-action="answer-quiz" data-answer="${index}" ${answered ? 'disabled' : ''}><span class="option-letter">${String.fromCharCode(65 + index)}</span><span>${escapeHtml(option)}</span></button>`).join('')}</div>${answered ? `<div class="quiz-feedback"><strong>${quizSession.answer === question.answer ? 'Resposta certa.' : 'Vamos revisar essa.'}</strong> ${escapeHtml(question.explanation)}</div><div class="form-actions"><button class="button button-primary" type="button" data-action="next-question">${quizSession.index === quizBank.length - 1 ? 'Ver resultado' : 'Próxima pergunta'}</button></div>` : ''}</article></section>`; }

  function renderRanking() { const unlocked = getAchievements().filter(item => item.unlocked).length; return `<section><div class="section-heading"><div><h2>Ranking local</h2><p>Um espelho do seu próprio ritmo neste navegador. Não é uma competição global nem mostra outros estudantes reais.</p></div></div><div class="panel-grid two"><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">SEU RITMO</p><h3>Progresso de consistência</h3></div><span class="metric-icon yellow">↗</span></div><div class="quiz-score"><strong>${getPoints()}</strong><span class="muted small">pontos locais · nível ${getLevel()}</span></div><div class="list" style="margin-top:15px"><div class="list-item"><div class="list-item-main"><span class="metric-icon orange">◷</span><div class="list-item-copy"><strong>${state.sessions.length} sessões</strong><small>focos finalizados</small></div></div><span class="list-item-side">${minutesLabel(getStudyMinutes())}</span></div><div class="list-item"><div class="list-item-main"><span class="metric-icon violet">✦</span><div class="list-item-copy"><strong>${unlocked} conquistas</strong><small>desbloqueadas</small></div></div><span class="list-item-side">${getStreak()} dias</span></div></div></article><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">PLACAR DEMONSTRATIVO</p><h3>Como você está usando o espaço</h3></div></div><div class="list"><div class="list-item"><div class="list-item-main"><span class="avatar avatar-small">${escapeHtml(initials(state.profile.name))}</span><div class="list-item-copy"><strong>${escapeHtml(state.profile.name || 'Estudante')}</strong><small>perfil ${state.profile.privateRanking ? 'oculto para rankings públicos' : 'visível localmente'}</small></div></div><span class="list-item-side text-orange">${getPoints()} pts</span></div></div><div class="info-note" style="margin-top:15px"><strong>Privacidade:</strong> o apelido e avatar não são enviados para nenhum ranking online nesta versão.</div></article></div><article class="card card-pad" style="margin-top:17px"><div class="card-title"><div><p class="eyebrow">CONQUISTAS</p><h3>Pequenos marcos contam</h3></div></div><div class="badge-grid">${getAchievements().map(item => `<div class="achievement ${item.unlocked ? '' : 'is-locked'}"><span class="achievement-icon">${item.icon}</span><strong>${item.name}</strong><small>${item.unlocked ? 'desbloqueada' : item.copy}</small></div>`).join('')}</div></article></section>`; }

  function statsBuckets(period) { const bucketSize = period === 7 ? 1 : 5; const bucketCount = period === 7 ? 7 : 6; return [...Array(bucketCount)].map((_, index) => { const end = new Date(); end.setHours(23, 59, 59, 999); end.setDate(end.getDate() - ((bucketCount - 1 - index) * bucketSize)); const start = new Date(end); start.setDate(start.getDate() - bucketSize + 1); const minutes = getStudyMinutes(state.sessions.filter(session => { const date = parseDate(session.date); return date && date >= start && date <= end; })); return { label: period === 7 ? new Intl.DateTimeFormat('pt-BR', { weekday: 'short' }).format(end).slice(0, 3) : `${String(start.getDate()).padStart(2, '0')}/${String(start.getMonth() + 1).padStart(2, '0')}`, minutes }; }); }
  function renderStats() { const sessions = sessionsInDays(statsPeriod); const bySubject = {}; sessions.forEach(session => { bySubject[session.subjectId || 'none'] = (bySubject[session.subjectId || 'none'] || 0) + session.minutes; }); const buckets = statsBuckets(statsPeriod); const max = Math.max(25, ...buckets.map(bucket => bucket.minutes)); return `<section><div class="section-heading"><div><h2>Estatísticas</h2><p>Veja o que foi registrado de verdade. Sem números de preenchimento e sem confundir pontuação com domínio do conteúdo.</p></div><div class="segmented"><button class="${statsPeriod === 7 ? 'is-active' : ''}" type="button" data-action="stats-period" data-period="7">7 dias</button><button class="${statsPeriod === 30 ? 'is-active' : ''}" type="button" data-action="stats-period" data-period="30">30 dias</button></div></div><div class="metric-grid">${metric('Hoje', minutesLabel(getStudyMinutes(getTodaySessions())), 'tempo focado', '◷', 'orange')}${metric(statsPeriod === 7 ? 'Semana' : 'Período', minutesLabel(getStudyMinutes(sessions)), statsPeriod === 7 ? 'últimos 7 dias' : 'últimos 30 dias', '▥', 'violet')}${metric('Sessões', String(state.sessions.length), 'histórico total', '↗', 'mint')}${metric('Quizzes', String(state.quizAttempts.length), 'tentativas locais', '△', 'yellow')}</div><div class="panel-grid wide"><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">RITMO</p><h3>${statsPeriod === 7 ? 'Minutos por dia' : 'Minutos por bloco de 5 dias'}</h3></div></div><div class="chart">${buckets.map(bucket => `<div class="chart-bar-wrap" title="${bucket.minutes} minutos"><span class="chart-bar" style="height:${Math.max(3, Math.round(bucket.minutes / max * 100))}%"></span><span class="chart-bar-label">${bucket.label}</span></div>`).join('')}</div></article><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">MATÉRIAS</p><h3>Tempo registrado</h3></div></div>${Object.keys(bySubject).length ? `<div class="legend-list">${Object.entries(bySubject).sort((a,b) => b[1] - a[1]).map(([id, minutes]) => `<div class="legend-item"><span>${subjectDot(id)} ${escapeHtml(getSubject(id)?.name || 'Sem matéria')}</span><strong>${minutesLabel(minutes)}</strong></div>`).join('')}</div>` : emptyState('Ainda sem distribuição', 'Finalize uma sessão com matéria selecionada para ver o tempo por área.', 'Ir para Pomodoro', 'go-timer')}</article></div><div class="info-note" style="margin-top:17px"><strong>Leitura responsável:</strong> estes gráficos mostram registros de atividade. Eles não medem sozinhos a aprendizagem ou a compreensão do conteúdo.</div></section>`; }

  function renderProfile() {
    const profileName = escapeHtml(state.profile.name || 'Estudante');
    const profileInitials = escapeHtml(initials(state.profile.name));
    return `<section class="profile-page"><article class="profile-panel card"><div class="profile-cover" aria-hidden="true"></div><div class="profile-panel-body"><div class="profile-identity-row"><div class="profile-identity"><span class="avatar profile-large-avatar">${profileInitials}</span><div><h2>${profileName}</h2><p>Perfil local · nível ${getLevel()}</p></div></div><button class="button button-primary profile-edit-button" type="button" data-action="focus-profile">Editar</button></div><form class="form-stack profile-form" id="profileForm"><div class="profile-fields"><div class="field"><label for="profileName">Nome completo</label><input id="profileName" name="name" value="${escapeHtml(state.profile.name)}" maxlength="40" required /></div><div class="field"><label for="dailyGoal">Meta diária</label><input id="dailyGoal" name="dailyGoal" type="number" min="5" max="600" value="${state.profile.dailyGoal}" required /></div><div class="field full"><label>Matérias favoritas</label><div class="profile-check-grid">${state.subjects.slice(0, 8).map(subject => `<label class="check-row"><input type="checkbox" name="favorite" value="${subject.id}" ${state.profile.favoriteSubjects.includes(subject.id) ? 'checked' : ''} /> ${escapeHtml(subject.name)}</label>`).join('')}</div></div><div class="field full"><label class="check-row"><input type="checkbox" name="privateRanking" ${state.profile.privateRanking ? 'checked' : ''} /> Não participar de rankings públicos</label></div></div><div class="profile-email-block"><h3>Meu espaço de estudo</h3><div class="profile-email-row"><span class="profile-email-icon">✦</span><div><strong>Dados salvos neste navegador</strong><small>Seu perfil, metas e preferências permanecem locais.</small></div></div><button class="button button-primary" type="submit">Salvar alterações</button></div></form></div></article></section>`;
  }
  function renderSettings() { return `<section><div class="section-heading"><div><h2>Configurações</h2><p>Controle aparência, backup e os limites deste espaço local.</p></div></div><div class="panel-grid two"><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">APARÊNCIA</p><h3>Preferência visual</h3></div></div><div class="segmented" style="width:100%"><button type="button" class="${state.profile.theme === 'dark' ? 'is-active' : ''}" data-action="set-theme" data-theme="dark">Escuro</button><button type="button" class="${state.profile.theme === 'light' ? 'is-active' : ''}" data-action="set-theme" data-theme="light">Claro</button></div><div class="info-note" style="margin-top:14px"><strong>Foco primeiro:</strong> o modo escuro reduz contrastes amplos para deixar o painel mais silencioso.</div></article><article class="card card-pad"><div class="card-title"><div><p class="eyebrow">DADOS</p><h3>Backup e privacidade</h3></div></div><div class="form-stack">${button('Exportar backup JSON', 'export-json', 'button-primary')} ${button('Importar backup JSON', 'import-backup', 'button-quiet')} ${button('Baixar flashcards CSV', 'export-csv', 'button-quiet')} ${button('Apagar dados locais', 'clear-data', 'button-danger button-quiet')} </div></article></div><article class="card card-pad" style="margin-top:17px"><div class="card-title"><div><p class="eyebrow">LIMITES DA VERSÃO</p><h3>O que é local e o que exige backend</h3></div></div><div class="panel-grid two"><div class="info-note"><strong>Funciona aqui:</strong> matérias, flashcards, revisão, Pomodoro, planner, quizzes, pontos, gráficos, preferências e backups ficam neste navegador.</div><div class="info-note"><strong>Exige infraestrutura:</strong> contas reais, sincronização entre dispositivos, presença em salas, mensagens, colaboração, IA generativa e rankings globais precisam de backend seguro.</div></div></article></section>`; }

