      app.innerHTML = `<div class="section-view">${(views[currentSection] || renderHome)()}</div>`;
    } catch (error) {
      console.error('Passo Compasso render error', error);
      app.innerHTML = `<div class="card card-pad"><div class="empty-state"><span class="empty-icon">!</span><strong>Não foi possível renderizar esta seção.</strong><p>Recarregue a página. Se persistir, exporte ou limpe os dados locais.</p></div></div>`;
    }
    updateTimerDisplay();
  }
  function goTo(section) { if (!navigation.some(item => item.id === section)) return; currentSection = section; const sidebar = $('#sidebar'); if (sidebar) sidebar.classList.remove('is-open'); render(); app.focus({ preventScroll: true }); }

  function renderHome() {
    const todayMinutes = getStudyMinutes(getTodaySessions());
