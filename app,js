  let timerTicker = null;
  let statsPeriod = 7;
  let lastFocus = null;
  let state;
  let loggedIn = localStorage.getItem(AUTH_KEY) === 'true' || sessionStorage.getItem(AUTH_SESSION_KEY) === 'true';

  const navigation = [
