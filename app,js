  const quizBank = [
    { id: 'q1', subject: 'Química', question: 'Qual partícula possui carga elétrica negativa?', options: ['Próton', 'Nêutron', 'Elétron', 'Núcleo'], answer: 2, explanation: 'O elétron possui carga negativa; prótons são positivos e nêutrons não possuem carga.' },
