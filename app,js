  function uid(prefix = 'item') { return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}`; }
  function todayKey(date = new Date()) { return date.toISOString().slice(0, 10); }
  function parseDate(value) { const date = new Date(`${value}T12:00:00`); return Number.isNaN(date.getTime()) ? null : date; }
  function formatDate(value, options = { day: '2-digit', month: 'short' }) { const date = value instanceof Date ? value : parseDate(value); return date ? new Intl.DateTimeFormat('pt-BR', options).format(date).replace('.', '') : 'Sem data'; }
  function formatLongDate(date = new Date()) { return new Intl.DateTimeFormat('pt-BR', { weekday: 'long', day: 'numeric', month: 'long' }).format(date); }
  function escapeHtml(value = '') { return String(value).replace(/[&<>'"]/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char])); }
  function clamp(value, min, max) { return Math.min(max, Math.max(min, value)); }
  function minutesLabel(minutes) { const safe = Math.max(0, Math.round(minutes || 0)); return safe < 60 ? `${safe} min` : `${Math.floor(safe / 60)}h ${safe % 60}min`; }
  function timeLabel(seconds) { const safe = Math.max(0, Math.floor(seconds || 0)); return `${String(Math.floor(safe / 60)).padStart(2, '0')}:${String(safe % 60).padStart(2, '0')}`; }
  function initials(name = 'Rafa') { return name.trim().split(/\s+/).map(part => part[0]).join('').slice(0, 2).toUpperCase() || 'S'; }
  function getSubject(id) { return state.subjects.find(subject => subject.id === id); }
  function getTodaySessions() { return state.sessions.filter(session => session.date === todayKey()); }
  function getStudyMinutes(sessions = state.sessions) { return sessions.reduce((sum, session) => sum + Number(session.minutes || 0), 0); }
  function startOfWeek(date = new Date()) { const copy = new Date(date); const day = copy.getDay(); const diff = day === 0 ? -6 : 1 - day; copy.setDate(copy.getDate() + diff); copy.setHours(0, 0, 0, 0); return copy; }
  function sessionsInDays(days) { const boundary = new Date(); boundary.setHours(0, 0, 0, 0); boundary.setDate(boundary.getDate() - (days - 1)); return state.sessions.filter(session => { const date = parseDate(session.date); return date && date >= boundary; }); }
  function getPoints() { return state.sessions.length * 10 + state.reviews.length * 3 + state.quizAttempts.reduce((sum, attempt) => sum + (attempt.correct * 5) + 2, 0) + state.tasks.filter(task => task.done).length * 4; }
  function getLevel() { return Math.max(1, Math.floor(getPoints() / 100) + 1); }
  function getStreak() {
    const days = new Set(state.sessions.map(session => session.date));
    let cursor = new Date();
    let streak = 0;
    while (days.has(todayKey(cursor))) { streak += 1; cursor.setDate(cursor.getDate() - 1); }
    return streak;
  }
  function seedState() {
    return {
      version: APP_VERSION,
      profile: { name: 'Rafa', avatar: 'R', dailyGoal: 60, favoriteSubjects: ['mat', 'qui'], theme: 'dark', privateRanking: true },
      subjects: seedSubjects.map(([id, name, abbr, color, description]) => ({ id, name, abbr, color, description, progress: 0, custom: false })),
      sets: [
        { id: 'set-chem', name: 'Ligações químicas', subjectId: 'qui', topic: 'Química', color: '#65d6a3', example: true, cards: [
          { id: 'card-chem-1', front: 'O que é uma ligação iônica?', back: 'É a atração eletrostática entre íons de cargas opostas, geralmente após transferência de elétrons.', difficulty: 'good', nextReview: todayKey(), reviews: 0 },
          { id: 'card-chem-2', front: 'O que caracteriza uma ligação covalente?', back: 'O compartilhamento de pares de elétrons entre átomos.', difficulty: 'good', nextReview: todayKey(), reviews: 0 },
        ] },
        { id: 'set-math', name: 'Logaritmos', subjectId: 'mat', topic: 'Matemática', color: '#ff8a24', example: true, cards: [
          { id: 'card-math-1', front: 'O que significa logₐ b = c?', back: 'Significa que a elevado a c é igual a b: aᶜ = b, com a > 0 e a ≠ 1.', difficulty: 'good', nextReview: todayKey(), reviews: 0 },
        ] },
        { id: 'set-his', name: 'Brasil República', subjectId: 'his', topic: 'História', color: '#f27783', example: true, cards: [
          { id: 'card-his-1', front: 'O que é uma fonte histórica?', back: 'Qualquer vestígio que ajude a interpretar experiências e processos do passado.', difficulty: 'good', nextReview: todayKey(), reviews: 0 },
        ] },
