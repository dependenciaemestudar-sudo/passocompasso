        { id: 'task-2', title: 'Ler capítulo de literatura', type: 'Leitura', subjectId: 'por', due: todayKey(new Date(Date.now() + 86400000 * 2)), priority: 'medium', estimate: 35, done: false, example: true },
      ],
      sessions: [], reviews: [], quizAttempts: [], quizzes: [], rooms: [
        { id: 'room-1', name: 'Foco de fim de tarde', subject: 'Livre', goal: 120, privacy: 'Pública', participants: [{ initial: 'R', color: '#ffb469', state: 'Você' }, { initial: 'L', color: '#a78bfa', state: 'ilustrativo' }, { initial: 'J', color: '#65d6a3', state: 'ilustrativo' }], example: true },
        { id: 'room-2', name: 'Química sem pressa', subject: 'Química', goal: 90, privacy: 'Pública', participants: [{ initial: 'R', color: '#ffb469', state: 'Você' }, { initial: 'M', color: '#f27783', state: 'ilustrativo' }], example: true },
      ],
      activeRoomId: null,
      timer: { mode: 'focus', duration: 1500, running: false, startedAt: null, elapsedBeforeStart: 0, subjectId: 'mat', objective: '', completedCycles: 0 },
    };
  }
  function record(value) { return value && typeof value === 'object' && !Array.isArray(value); }
  function textValue(value, fallback = '', max = 500) { return typeof value === 'string' ? value.trim().slice(0, max) : fallback; }
  function normalizeState(input) {
    if (!record(input)) throw new Error('Formato de backup inválido');
    const base = seedState();
    const profile = record(input.profile) ? input.profile : {};
    base.profile = { ...base.profile, name: textValue(profile.name, base.profile.name, 40) || base.profile.name, avatar: textValue(profile.avatar, base.profile.avatar, 3), dailyGoal: clamp(Number(profile.dailyGoal) || base.profile.dailyGoal, 5, 600), favoriteSubjects: Array.isArray(profile.favoriteSubjects) ? profile.favoriteSubjects.filter(item => typeof item === 'string').slice(0, 12) : base.profile.favoriteSubjects, theme: profile.theme === 'light' ? 'light' : 'dark', privateRanking: profile.privateRanking !== false };
    if (Array.isArray(input.subjects)) base.subjects = input.subjects.filter(record).map(subject => ({ id: textValue(subject.id, uid('subject'), 50), name: textValue(subject.name, '', 45), abbr: textValue(subject.abbr, '+', 2).toUpperCase(), color: /^#[0-9a-f]{6}$/i.test(subject.color) ? subject.color : '#ff8a24', description: textValue(subject.description, '', 140), progress: clamp(Number(subject.progress) || 0, 0, 100), custom: Boolean(subject.custom) })).filter(subject => subject.name);
