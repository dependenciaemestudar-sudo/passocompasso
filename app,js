  function renderRoomEntry() { const rooms = state.rooms; return `<section class="room-entry-page"><div class="room-entry-header"><div><p class="eyebrow">SALA DE ESTUDOS</p><h2>Escolha seu próximo foco.</h2><p>Veja quem está estudando, qual matéria está aberta e entre quando encontrar o seu ritmo.</p></div><div class="room-entry-actions">${button('Criar sala', 'open-room-modal', 'button-primary button-small')}</div></div><div class="room-entry-note"><span class="room-entry-note-icon">◎</span><span><strong>Um armário de salas, não uma rede social.</strong><small>Os participantes são ilustrativos e os dados ficam somente neste navegador.</small></span></div><div class="room-wardrobe"><div class="wardrobe-topline"><span>PRATELEIRA DE FOCO</span><span>${rooms.length} salas disponíveis</span></div><div class="room-shelves">${rooms.map(roomShelf).join('')}</div></div><div class="room-entry-footer"><span class="focus-local-dot"></span><span>Escolha uma sala para abrir o Pomodoro ou o cronômetro ao lado dos participantes.</span></div></section>`; }
  function renderFocusRoom(activeRoom) { const timer = state.timer; const elapsed = currentElapsed(); const remaining = timer.duration ? Math.max(0, timer.duration - elapsed) : elapsed; const modeLabel = timer.mode === 'free' ? 'cronômetro' : 'pomodoro'; return `<section class="focus-room-page focus-room-active"><div class="focus-room-top"><div class="focus-brand"><span class="focus-brand-mark">◎</span><div><strong>${escapeHtml(activeRoom.name)}</strong><small>${escapeHtml(activeRoom.subject)} · sala local</small></div></div><div class="focus-room-actions"><span class="focus-local-dot"></span><span>sessão local</span>${button('Sair da sala', 'leave-room', 'focus-quiet button-small')}</div></div><div class="focus-active-layout"><div class="focus-room-stage"><div class="focus-room-copy"><p class="eyebrow">${escapeHtml(activeRoom.subject)} · ${modeLabel}</p><h2>Seu momento de foco.</h2><p>Escolha entre blocos guiados ou conte seu tempo livre.</p></div><div class="focus-mode-tabs"><button class="${timer.mode !== 'free' ? 'is-active' : ''}" data-action="timer-mode" data-mode="focus" type="button">pomodoro</button><button class="${timer.mode === 'free' ? 'is-active' : ''}" data-action="timer-mode" data-mode="free" type="button">cronômetro</button></div><div class="focus-timer" id="timerDisplay">${timeLabel(remaining)}</div><div class="focus-controls">${button(timer.running ? 'pausar' : 'iniciar', timer.running ? 'pause-timer' : 'start-timer', 'focus-start')}${button('↻', 'reset-timer', 'focus-reset')}</div><div class="focus-dots"><i class="is-on"></i><i class="${timer.completedCycles > 0 ? 'is-on' : ''}"></i><i class="${timer.completedCycles > 1 ? 'is-on' : ''}"></i><i class="${timer.completedCycles > 2 ? 'is-on' : ''}"></i></div></div><aside class="focus-participants-panel"><div class="focus-participants-heading"><div><p class="eyebrow">NA SALA AGORA</p><h3>Ritmos em andamento</h3></div><span>${activeRoom.participants.length}</span></div><div class="focus-participants-list">${activeRoom.participants.map((person, index) => participantRow(person, activeRoom, index)).join('')}</div><p class="focus-participants-disclaimer">Presenças demonstrativas para organizar seu foco. Não há usuários conectados nesta versão.</p></aside></div></section>`; }
  function renderRoomPomodoro() { const timer = state.timer; const elapsed = currentElapsed(); const remaining = timer.duration ? Math.max(0, timer.duration - elapsed) : elapsed; const subject = getSubject(timer.subjectId); return `<article class="card room-pomodoro"><div><p class="eyebrow">POMODORO DA SALA</p><h3>Estude no seu compasso</h3><p class="muted small">Um bloco simples para acompanhar esta mesa. Sem metas extras.</p></div><strong class="room-timer-display" id="timerDisplay">${timeLabel(remaining)}</strong><div class="room-pomodoro-actions">${button(timer.running ? 'Pausar' : elapsed > 0 ? 'Continuar' : 'Iniciar', timer.running ? 'pause-timer' : 'start-timer', 'button-primary button-small')}${button('Reiniciar', 'reset-timer', 'button-quiet button-small')}<span class="muted small">${escapeHtml(subject?.name || 'Sem matéria')}</span></div></article>`; }
