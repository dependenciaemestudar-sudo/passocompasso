            <div class="focus-foot"><span>${percent >= 100 ? 'Meta concluída' : 'Sem pressão: escolha o próximo bloco'}</span><strong class="text-orange">${minutesLabel(goal - todayMinutes)} restantes</strong></div>
          </article>
        </div>
        <div class="metric-grid">
          ${metric('Tempo hoje', minutesLabel(todayMinutes), 'foco registrado', '◷', 'orange')}
          ${metric('Sequência', `${getStreak()} ${getStreak() === 1 ? 'dia' : 'dias'}`, 'dias seguidos', '↗', 'violet')}
          ${metric('Revisões', String(state.reviews.length), 'cartões marcados', '◇', 'mint')}
          ${metric('Pontos locais', String(getPoints()), `nível ${getLevel()}`, '✦', 'yellow')}
        </div>
        <div class="dashboard-grid">
          <div class="dashboard-stack">
            <article class="card card-pad">
              <div class="card-title"><div><p class="eyebrow">RETOMADA</p><h3>Continue de onde parou</h3></div>${button('Ver flashcards', 'go-flashcards', 'button-quiet button-small')}</div>
