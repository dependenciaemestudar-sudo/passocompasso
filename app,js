  function metric(label, value, foot, icon, color) { return `<article class="card metric-card"><div class="metric-card-top"><span>${label}</span><span class="metric-icon ${color}" aria-hidden="true">${icon}</span></div><strong class="metric-value">${value}</strong><span class="metric-foot">${foot}</span></article>`; }
  function taskRow(task) { const subject = getSubject(task.subjectId); const due = parseDate(task.due); const isSoon = due && (due - new Date()) < 86400000 * 2; return `<div class="list-item"><div class="list-item-main">${subjectDot(task.subjectId)}<div class="list-item-copy"><strong>${escapeHtml(task.title)}</strong><small>${escapeHtml(task.type)} · ${escapeHtml(subject?.name || 'Sem matéria')} ${task.example ? '· exemplo editável' : ''}</small></div></div><div class="list-item-side ${isSoon ? 'text-orange' : ''}">${formatDate(task.due, { day: '2-digit', month: 'short' })}</div></div>`; }
