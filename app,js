  function sessionCards(set) { const ids = flashcardSession?.order?.length ? flashcardSession.order : set.cards.map(card => card.id); const cards = ids.map(id => set.cards.find(card => card.id === id)).filter(Boolean); const filtered = flashcardSession?.filter === 'hard' ? cards.filter(card => card.difficulty === 'hard') : cards; return filtered.length ? filtered : cards; }
  function renderFlashcards() {
