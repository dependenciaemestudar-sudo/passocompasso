    if (Array.isArray(input.tasks)) base.tasks = input.tasks.filter(record).map(task => ({ id: textValue(task.id, uid('task'), 50), title: textValue(task.title, 'Tarefa sem nome', 80), type: textValue(task.type, 'Estudo', 30), subjectId: textValue(task.subjectId, '', 50), due: /^\d{4}-\d{2}-\d{2}$/.test(task.due) ? task.due : todayKey(), priority: ['high', 'medium', 'low'].includes(task.priority) ? task.priority : 'medium', estimate: clamp(Number(task.estimate) || 25, 5, 600), done: Boolean(task.done), example: Boolean(task.example) })).filter(task => task.title);
    if (Array.isArray(input.sessions)) base.sessions = input.sessions.filter(record).map(session => ({ id: textValue(session.id, uid('session'), 60), date: /^\d{4}-\d{2}-\d{2}$/.test(session.date) ? session.date : todayKey(), subjectId: textValue(session.subjectId, '', 50), minutes: clamp(Number(session.minutes) || 0, 0, 1440), objective: textValue(session.objective, '', 120), mode: textValue(session.mode, 'focus', 20) })).filter(session => session.minutes > 0);
    if (Array.isArray(input.reviews)) base.reviews = input.reviews.filter(record).map(review => ({ id: textValue(review.id, uid('review'), 60), cardId: textValue(review.cardId, '', 60), setId: textValue(review.setId, '', 60), date: /^\d{4}-\d{2}-\d{2}$/.test(review.date) ? review.date : todayKey(), rating: ['hard', 'good', 'easy'].includes(review.rating) ? review.rating : 'good' }));
    if (Array.isArray(input.quizAttempts)) base.quizAttempts = input.quizAttempts.filter(record).map(attempt => ({ id: textValue(attempt.id, uid('quiz'), 60), date: /^\d{4}-\d{2}-\d{2}$/.test(attempt.date) ? attempt.date : todayKey(), correct: clamp(Number(attempt.correct) || 0, 0, 100), total: clamp(Number(attempt.total) || 1, 1, 100), points: clamp(Number(attempt.points) || 0, 0, 1000) }));
    if (Array.isArray(input.quizzes)) base.quizzes = input.quizzes.filter(record).map(question => ({ id: textValue(question.id, uid('question'), 60), subject: textValue(question.subject, 'Revisão', 40), question: textValue(question.question, '', 240), options: Array.isArray(question.options) ? question.options.slice(0, 4).map(option => textValue(option, '', 160)) : [], answer: clamp(Number(question.answer) || 0, 0, 3), explanation: textValue(question.explanation, 'Revise o conceito e tente novamente.', 400) })).filter(question => question.question && question.options.length === 4 && question.options.every(Boolean));
    if (Array.isArray(input.rooms)) base.rooms = input.rooms.filter(record).map(room => ({ id: textValue(room.id, uid('room'), 60), name: textValue(room.name, 'Sala local', 50), subject: textValue(room.subject, 'Foco livre', 45), goal: clamp(Number(room.goal) || 90, 15, 600), privacy: 'Local', participants: Array.isArray(room.participants) ? room.participants.filter(record).slice(0, 12).map(person => ({ initial: textValue(person.initial, 'S', 2), color: /^#[0-9a-f]{6}$/i.test(person.color) ? person.color : '#ffb469', state: textValue(person.state, 'ilustrativo', 30) })) : [], example: Boolean(room.example) }));
    const timer = record(input.timer) ? input.timer : {};
    base.timer = { ...base.timer, mode: ['focus', 'break', 'longBreak', 'free', 'custom'].includes(timer.mode) ? timer.mode : 'focus', duration: clamp(Number(timer.duration) || 1500, 0, 10800), running: Boolean(timer.running), startedAt: Number.isFinite(Number(timer.startedAt)) ? Number(timer.startedAt) : null, elapsedBeforeStart: clamp(Number(timer.elapsedBeforeStart) || 0, 0, 10800), subjectId: textValue(timer.subjectId, 'mat', 50), objective: textValue(timer.objective, '', 70), completedCycles: Math.max(0, Number(timer.completedCycles) || 0) };
    base.activeRoomId = typeof input.activeRoomId === 'string' ? input.activeRoomId : null;
    return base;
  }
  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return seedState();
      const parsed = JSON.parse(raw);
      if (!parsed || parsed.version !== APP_VERSION) throw new Error('invalid');
      return normalizeState(parsed);
    } catch (error) {
      localStorage.removeItem(STORAGE_KEY);
      setTimeout(() => toast('Os dados locais estavam incompletos. Um espaço novo foi criado.', 'warning'), 0);
      return seedState();
    }
  }
  function saveState() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); updateChrome(); } catch (error) { toast('Não foi possível salvar no navegador. Tente exportar um backup.', 'warning'); }
  }

  function updateChrome() {
    document.documentElement.dataset.theme = state.profile.theme === 'light' ? 'light' : 'dark';
    const avatar = initials(state.profile.name);
    ['#sidebarAvatar', '#topAvatar'].forEach(selector => { const node = $(selector); if (node) node.textContent = avatar; });
    const name = $('#sidebarName'); if (name) name.textContent = state.profile.name || 'Estudante';
    const nav = $('#primaryNav');
    if (nav) nav.innerHTML = navigation.map(item => `<button class="nav-item ${item.id === currentSection ? 'is-active' : ''}" data-section="${item.id}" type="button"><span class="nav-icon ${item.icon}" aria-hidden="true"></span><span class="nav-item-label">${item.label}</span></button>`).join('');
    const mobile = $('#mobileNav');
    if (mobile) {
      const mobileItems = ['flashcards', 'subjects', 'rooms', 'profile'];
      mobile.innerHTML = mobileItems.map(id => { const item = navigation.find(navItem => navItem.id === id); return `<button type="button" data-section="${id}" class="${id === currentSection ? 'is-active' : ''}"><span class="nav-icon ${item.icon}" aria-hidden="true"></span>${item.label}</button>`; }).join('');
    }
    const meta = navigation.find(item => item.id === currentSection) || navigation[0];
    $('#sectionTitle').textContent = meta.label;
    $('#sectionEyebrow').textContent = meta.eyebrow;
  }

  function showAuth() { const overlay = $('#authOverlay'); if (!overlay) return; overlay.hidden = false; document.body.classList.add('is-logged-out'); window.setTimeout(() => $('#loginName')?.focus(), 0); }
  function toast(message, tone = 'success') {
    const item = document.createElement('div'); item.className = `toast ${tone === 'warning' ? 'is-warning' : ''}`; item.textContent = message; toastRegion.appendChild(item); liveRegion.textContent = message;
    window.setTimeout(() => item.remove(), 3600);
  }
  function openModal(content) { lastFocus = document.activeElement; modalRoot.innerHTML = `<div class="modal" role="dialog" aria-modal="true">${content}</div>`; const dialog = $('.modal', modalRoot); const title = $('h2', dialog); if (title) { title.id = 'modalTitle'; dialog.setAttribute('aria-labelledby', 'modalTitle'); } modalRoot.setAttribute('aria-hidden', 'false'); const first = $('input, select, textarea, button', modalRoot); if (first) first.focus(); }
  function closeModal() { modalRoot.innerHTML = ''; modalRoot.setAttribute('aria-hidden', 'true'); if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus(); lastFocus = null; }
  function button(label, action, extra = '') { return `<button type="button" class="button ${extra}" data-action="${action}">${label}</button>`; }
  function subjectDot(subjectId) { const subject = getSubject(subjectId); return `<span class="subject-dot" style="background:${escapeHtml(subject?.color || '#9d9eaa')}" aria-hidden="true"></span>`; }
  function subjectOptions(selected = '') { return state.subjects.map(subject => `<option value="${escapeHtml(subject.id)}" ${subject.id === selected ? 'selected' : ''}>${escapeHtml(subject.name)}</option>`).join(''); }
  function greeting() { const hour = new Date().getHours(); return hour < 12 ? 'Bom dia' : hour < 18 ? 'Boa tarde' : 'Boa noite'; }

  function render() {
    updateChrome();
    const authOverlay = $('#authOverlay');
    if (authOverlay) authOverlay.hidden = loggedIn;
    document.body.classList.toggle('is-logged-out', !loggedIn);
    if (!loggedIn) return;
    const views = { home: renderHome, subjects: renderSubjects, flashcards: renderFlashcards, assistant: renderAssistant, rooms: renderRooms, timer: renderTimer, quizzes: renderQuizzes, ranking: renderRanking, planner: renderPlanner, stats: renderStats, profile: renderProfile, settings: renderSettings };
