    const percent = clamp(Math.round(todayMinutes / goal * 100), 0, 100);
    const recentSets = state.sets.slice(0, 2);
    const upcoming = state.tasks.filter(task => !task.done).sort((a, b) => String(a.due).localeCompare(String(b.due))).slice(0, 3);
