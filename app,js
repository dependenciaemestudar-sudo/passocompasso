    const achievements = getAchievements().slice(0, 3);
    return `
      <section aria-labelledby="home-title">
        <div class="dashboard-hero">
          <article class="card hero-card">
            <p class="eyebrow">${greeting()}, ${escapeHtml(state.profile.name || 'estudante')}</p>
