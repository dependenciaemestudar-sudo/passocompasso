  function openSetModal(set = null) { openModal(`<div class="modal-head"><div><h2>${set ? 'Editar conjunto' : 'Novo conjunto'}</h2><p>Comece com um tema pequeno. Você poderá adicionar cartões em seguida.</p></div>${button('Fechar', 'close-modal', 'button-quiet button-small')}</div><form class="form-stack" id="setForm"><input type="hidden" name="id" value="${set?.id || ''}" /><div class="form-grid"><div class="field full"><label for="setName">Nome do conjunto</label><input id="setName" name="name" value="${escapeHtml(set?.name || '')}" placeholder="Ex.: Revolução Industrial" maxlength="60" required /></div><div class="field"><label for="setSubject">Matéria</label><select id="setSubject" name="subjectId">${subjectOptions(set?.subjectId || '')}</select></div><div class="field"><label for="setTopic">Tópico</label><input id="setTopic" name="topic" value="${escapeHtml(set?.topic || '')}" placeholder="Ex.: conceitos-chave" maxlength="50" /></div></div><div class="form-actions"><button class="button button-primary" type="submit">${set ? 'Salvar alterações' : 'Criar conjunto'}</button></div></form>`); }
  function openCardModal() { openModal(`<div class="modal-head"><div><h2>Novo flashcard</h2><p>Escreva uma pergunta que exija recuperação, não só releitura.</p></div>${button('Fechar', 'close-modal', 'button-quiet button-small')}</div><form class="form-stack" id="cardForm"><div class="field"><label for="cardSet">Conjunto</label><select id="cardSet" name="setId">${state.sets.map(set => `<option value="${set.id}">${escapeHtml(set.name)}</option>`).join('')}</select></div><div class="field"><label for="cardFront">Frente · pergunta</label><textarea id="cardFront" name="front" maxlength="260" required></textarea></div><div class="field"><label for="cardBack">Verso · resposta</label><textarea id="cardBack" name="back" maxlength="500" required></textarea></div><div class="form-actions"><button class="button button-primary" type="submit">Salvar cartão</button></div></form>`); }
  function openTaskModal() { openModal(`<div class="modal-head"><div><h2>Adicionar tarefa</h2><p>Defina um próximo passo possível e uma data clara.</p></div>${button('Fechar', 'close-modal', 'button-quiet button-small')}</div><form class="form-stack" id="taskForm"><div class="form-grid"><div class="field full"><label for="taskTitle">O que precisa acontecer?</label><input id="taskTitle" name="title" placeholder="Ex.: Resolver exercícios 1–10" maxlength="80" required /></div><div class="field"><label for="taskType">Tipo</label><select id="taskType" name="type"><option>Estudo</option><option>Prova</option><option>Trabalho</option><option>Revisão</option><option>Leitura</option></select></div><div class="field"><label for="taskSubject">Matéria</label><select id="taskSubject" name="subjectId"><option value="">Sem matéria</option>${subjectOptions()}</select></div><div class="field"><label for="taskDue">Data</label><input id="taskDue" name="due" type="date" value="${todayKey()}" required /></div><div class="field"><label for="taskEstimate">Estimativa (min)</label><input id="taskEstimate" name="estimate" type="number" min="5" max="600" value="25" required /></div><div class="field"><label for="taskPriority">Prioridade</label><select id="taskPriority" name="priority"><option value="high">Alta</option><option value="medium" selected>Média</option><option value="low">Baixa</option></select></div></div><div class="form-actions"><button class="button button-primary" type="submit">Adicionar tarefa</button></div></form>`); }
  function openRoomModal() { openModal(`<div class="modal-head"><div><h2>Criar sala local</h2><p>Uma sala visual para organizar seu foco. Não haverá conexão com outros estudantes.</p></div>${button('Fechar', 'close-modal', 'button-quiet button-small')}</div><form class="form-stack" id="roomForm"><div class="form-grid"><div class="field full"><label for="roomName">Nome da sala</label><input id="roomName" name="name" placeholder="Ex.: Foco antes da prova" maxlength="50" required /></div><div class="field"><label for="roomSubject">Matéria/objetivo</label><input id="roomSubject" name="subject" placeholder="Ex.: revisão geral" maxlength="45" /></div><div class="field"><label for="roomGoal">Meta coletiva (min)</label><input id="roomGoal" name="goal" type="number" min="15" max="600" value="90" required /></div></div><div class="form-actions"><button class="button button-primary" type="submit">Criar sala</button></div></form>`); }
  function openQuizModal() { openModal(`<div class="modal-head"><div><h2>Criar pergunta local</h2><p>Adicione uma pergunta à prática deste navegador.</p></div>${button('Fechar', 'close-modal', 'button-quiet button-small')}</div><form class="form-stack" id="quizForm"><div class="field"><label for="quizSubject">Matéria</label><input id="quizSubject" name="subject" value="Revisão" maxlength="40" required /></div><div class="field"><label for="quizQuestion">Pergunta</label><textarea id="quizQuestion" name="question" maxlength="240" required></textarea></div><div class="form-grid"><div class="field"><label for="quizOptionA">Alternativa A</label><input id="quizOptionA" name="optionA" required /></div><div class="field"><label for="quizOptionB">Alternativa B</label><input id="quizOptionB" name="optionB" required /></div><div class="field"><label for="quizOptionC">Alternativa C</label><input id="quizOptionC" name="optionC" required /></div><div class="field"><label for="quizOptionD">Alternativa D</label><input id="quizOptionD" name="optionD" required /></div><div class="field"><label for="quizAnswer">Resposta correta</label><select id="quizAnswer" name="answer"><option value="0">A</option><option value="1">B</option><option value="2">C</option><option value="3">D</option></select></div></div><div class="field"><label for="quizExplanation">Explicação</label><textarea id="quizExplanation" name="explanation" maxlength="400" placeholder="Por que essa é a resposta?"></textarea></div><div class="form-actions"><button class="button button-primary" type="submit">Adicionar à prática</button></div></form>`); }

  function handleSubmit(event) {
    const form = event.target;
    const data = new FormData(form);
    if (form.id === 'loginForm') {
      const name = String(data.get('name') || '').trim() || 'Estudante';
      const remember = data.get('remember') === 'on';
      state.profile.name = name;
      state.profile.avatar = initials(name);
      state.profile.theme = 'light';
      loggedIn = true;
      if (remember) { localStorage.setItem(AUTH_KEY, 'true'); sessionStorage.removeItem(AUTH_SESSION_KEY); }
      else { sessionStorage.setItem(AUTH_SESSION_KEY, 'true'); localStorage.removeItem(AUTH_KEY); }
      saveState();
      render();
      toast(`Bem-vindo ao seu compasso, ${name}.`);
      return;
    }
    if (form.id === 'subjectForm') { const id = data.get('id'); const existing = state.subjects.find(subject => subject.id === id); const color = /^#[0-9a-f]{6}$/i.test(data.get('color')) ? data.get('color') : '#ff8a24'; const subject = { id: id || uid('subject'), name: data.get('name').trim(), abbr: data.get('abbr').trim().slice(0, 2).toUpperCase(), color, description: data.get('description').trim(), progress: existing?.progress || 0, custom: true }; if (existing) Object.assign(existing, subject); else state.subjects.push(subject); saveState(); closeModal(); render(); toast(existing ? 'Matéria atualizada.' : 'Matéria criada.'); }
    if (form.id === 'setForm') { const id = data.get('id'); const subjectId = data.get('subjectId'); const subject = getSubject(subjectId); const existing = state.sets.find(set => set.id === id); if (existing) { existing.name = data.get('name').trim(); existing.subjectId = subjectId; existing.topic = data.get('topic').trim() || 'Revisão'; existing.color = subject?.color || existing.color; } else { state.sets.unshift({ id: uid('set'), name: data.get('name').trim(), subjectId, topic: data.get('topic').trim() || 'Revisão', color: subject?.color || '#ff8a24', cards: [], example: false }); } saveState(); closeModal(); flashcardSession = existing ? { setId: existing.id, index: 0, order: existing.cards.map(card => card.id), flipped: false } : null; currentSection = 'flashcards'; render(); toast(existing ? 'Conjunto atualizado.' : 'Conjunto criado. Adicione seu primeiro cartão.'); }
    if (form.id === 'cardForm') { const set = state.sets.find(item => item.id === data.get('setId')); if (!set) return; set.cards.push({ id: uid('card'), front: data.get('front').trim(), back: data.get('back').trim(), difficulty: 'new', nextReview: todayKey(), reviews: 0 }); saveState(); closeModal(); flashcardSession = { setId: set.id, index: set.cards.length - 1, order: set.cards.map(card => card.id), flipped: false }; currentSection = 'flashcards'; render(); toast('Cartão salvo no conjunto.'); }
    if (form.id === 'taskForm') { state.tasks.push({ id: uid('task'), title: data.get('title').trim(), type: data.get('type'), subjectId: data.get('subjectId'), due: data.get('due'), priority: data.get('priority'), estimate: Number(data.get('estimate')), done: false, example: false }); saveState(); closeModal(); render(); toast('Tarefa adicionada ao planner.'); }
    if (form.id === 'roomForm') { state.rooms.push({ id: uid('room'), name: data.get('name').trim(), subject: data.get('subject').trim() || 'Foco livre', goal: Number(data.get('goal')), privacy: 'Local', participants: [{ initial: initials(state.profile.name).slice(0, 1), color: '#ffb469', state: 'Você' }], example: false }); saveState(); closeModal(); render(); toast('Sala local criada.'); }
    if (form.id === 'quizForm') { const question = { id: uid('question'), subject: data.get('subject').trim(), question: data.get('question').trim(), options: [data.get('optionA'), data.get('optionB'), data.get('optionC'), data.get('optionD')].map(value => String(value).trim()), answer: Number(data.get('answer')), explanation: data.get('explanation').trim() || 'Revise o conceito e tente novamente.' }; quizBank.push(question); state.quizzes.push(question); saveState(); closeModal(); render(); toast('Pergunta adicionada à prática local.'); }
    if (form.id === 'timerForm') { state.timer.subjectId = data.get('subjectId'); state.timer.objective = data.get('objective').trim(); const custom = Number(data.get('customDuration')); if (custom > 0) { state.timer.duration = custom * 60; state.timer.mode = 'custom'; } saveState(); render(); toast('Intenção da sessão salva.'); }
    if (form.id === 'profileForm') { state.profile.name = data.get('name').trim() || 'Estudante'; state.profile.dailyGoal = Number(data.get('dailyGoal')) || 60; state.profile.favoriteSubjects = data.getAll('favorite'); state.profile.privateRanking = data.get('privateRanking') === 'on'; saveState(); render(); toast('Perfil atualizado neste navegador.'); }
    if (form.id === 'assistantForm') { const minutes = clamp(Number(data.get('availableMinutes')) || 25, 5, 240); const suggestion = getRecommendations(1)[0]; const result = $('#assistantResult'); if (result) result.innerHTML = `<div class="recommendation"><span class="recommendation-icon">◷</span><span><strong>${minutes} min: ${escapeHtml(suggestion.title)}</strong><p>${escapeHtml(suggestion.copy)} Comece com ${Math.min(minutes, 25)} min e faça uma pausa curta.</p></span></div>`; }
  }

  function setTimerMode(mode) { const durations = { focus: 25, break: 5, longBreak: 15, free: 0 }; if (state.timer.running) { toast('Pause ou finalize a sessão antes de trocar o modo.', 'warning'); return; } state.timer.mode = mode; state.timer.duration = durations[mode] * 60; state.timer.elapsedBeforeStart = 0; state.timer.startedAt = null; state.timer.objective = ''; saveState(); render(); }
  function rateCard(rating) { if (!flashcardSession) return; const set = state.sets.find(item => item.id === flashcardSession.setId); const card = set?.cards.find(item => item.id === flashcardSession.currentCardId) || set?.cards[flashcardSession.index]; if (!card) return; const intervals = { hard: 1, good: Math.min(14, Math.max(2, (card.interval || 1) * 2)), easy: Math.min(30, Math.max(4, (card.interval || 2) * 3)) }; card.difficulty = rating; card.interval = intervals[rating]; const next = new Date(); next.setDate(next.getDate() + intervals[rating]); card.nextReview = todayKey(next); card.reviews = (card.reviews || 0) + 1; state.reviews.push({ id: uid('review'), cardId: card.id, setId: set.id, date: todayKey(), rating }); saveState(); flashcardSession.flipped = false; const cards = sessionCards(set); flashcardSession.index = cards.length ? (flashcardSession.index + 1) % cards.length : 0; render(); toast(rating === 'hard' ? 'Cartão marcado para voltar cedo.' : 'Revisão registrada.'); }
  function shuffleCards() { if (!flashcardSession) return; flashcardSession.order = [...flashcardSession.order].sort(() => Math.random() - .5); flashcardSession.index = 0; flashcardSession.flipped = false; render(); toast('Ordem embaralhada.'); }

  function exportJSON() { const blob = new Blob([JSON.stringify({ exportedAt: new Date().toISOString(), app: 'Passo Compasso', version: APP_VERSION, data: state }, null, 2)], { type: 'application/json' }); download(blob, `passo-compasso-backup-${todayKey()}.json`); toast('Backup JSON exportado.'); }
  function exportCSV() { const rows = [['Conjunto', 'Matéria', 'Frente', 'Verso', 'Dificuldade', 'Próxima revisão']]; state.sets.forEach(set => set.cards.forEach(card => rows.push([set.name, getSubject(set.subjectId)?.name || '', card.front, card.back, card.difficulty, card.nextReview]))); const csv = rows.map(row => row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(';')).join('\n'); download(new Blob([`\ufeff${csv}`], { type: 'text/csv;charset=utf-8' }), `passo-compasso-flashcards-${todayKey()}.csv`); toast('CSV de flashcards exportado.'); }
  function download(blob, filename) { const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = filename; link.click(); URL.revokeObjectURL(link.href); }
  function importBackup() { const input = document.createElement('input'); input.type = 'file'; input.accept = '.json,application/json'; input.addEventListener('change', () => { const file = input.files?.[0]; if (!file) return; const reader = new FileReader(); reader.onload = () => { try { const parsed = JSON.parse(reader.result); const incoming = parsed.data || parsed; if (!record(incoming) || incoming.version !== APP_VERSION) throw new Error('Formato incompleto'); if (!window.confirm('Importar este backup substituirá os dados locais atuais. Continuar?')) return; state = normalizeState(incoming); saveState(); flashcardSession = null; render(); toast('Backup importado e validado.'); } catch (error) { toast('Não foi possível importar: formato inválido.', 'warning'); } }; reader.readAsText(file); }); input.click(); }
  function clearData() { if (!window.confirm('Apagar todos os dados locais? Essa ação não pode ser desfeita sem um backup.')) return; localStorage.removeItem(STORAGE_KEY); state = seedState(); flashcardSession = null; quizSession = null; saveState(); render(); toast('Dados locais apagados.'); }

  function startQuiz() { quizSession = { index: 0, answer: null, correct: 0 }; render(); }
  function answerQuiz(answer) { if (!quizSession || quizSession.answer !== null) return; quizSession.answer = Number(answer); if (quizSession.answer === quizBank[quizSession.index].answer) quizSession.correct += 1; render(); }
  function nextQuestion() { if (!quizSession) return; if (quizSession.index < quizBank.length - 1) { quizSession.index += 1; quizSession.answer = null; render(); } else { const points = quizSession.correct * 5 + 2; state.quizAttempts.push({ id: uid('quiz'), date: todayKey(), correct: quizSession.correct, total: quizBank.length, points }); saveState(); quizSession = null; render(); toast(`Prática concluída: ${points} pontos locais.`); } }

  function handleAction(event) {
    const target = event.target.closest('[data-action], [data-section]'); if (!target) return;
    if (!loggedIn && !target.closest('#authOverlay')) { showAuth(); return; }
    if (target.dataset.section) { goTo(target.dataset.section); return; }
    const action = target.dataset.action;
    if (action === 'logout') { loggedIn = false; localStorage.removeItem(AUTH_KEY); sessionStorage.removeItem(AUTH_SESSION_KEY); render(); return; }
    if (action === 'toggle-theme') { state.profile.theme = state.profile.theme === 'light' ? 'dark' : 'light'; saveState(); render(); }
    if (action === 'set-theme') { state.profile.theme = target.dataset.theme; saveState(); render(); }
    if (action === 'focus-profile') { $('#profileName')?.focus(); }
    if (action === 'go-timer' || action === 'go-room') goTo('rooms');
    if (action === 'go-flashcards') goTo('flashcards');
    if (action === 'go-planner') goTo('planner');
    if (action === 'go-ranking') goTo('ranking');
    if (action === 'go-subjects') goTo('subjects');
    if (action === 'open-subject-modal') openSubjectModal();
    if (action === 'edit-subject') { const subject = getSubject(target.dataset.subjectId); if (subject) openSubjectModal(subject); }
    if (action === 'open-set-modal') openSetModal();
    if (action === 'edit-set') { const set = state.sets.find(item => item.id === flashcardSession?.setId); if (set) openSetModal(set); }
    if (action === 'delete-set') { const set = state.sets.find(item => item.id === flashcardSession?.setId); if (set && window.confirm(`Excluir o conjunto “${set.name}” e seus cartões?`)) { state.sets = state.sets.filter(item => item.id !== set.id); flashcardSession = null; saveState(); render(); toast('Conjunto removido.'); } }
    if (action === 'open-card-modal') state.sets.length ? openCardModal() : openSetModal();
    if (action === 'open-task-modal') openTaskModal();
    if (action === 'open-room-modal') openRoomModal();
    if (action === 'open-quiz-modal') openQuizModal();
    if (action === 'close-modal') closeModal();
    if (action === 'select-set') { flashcardSession = { setId: target.dataset.setId, index: 0, order: state.sets.find(set => set.id === target.dataset.setId)?.cards.map(card => card.id) || [], flipped: false }; render(); }
    if (action === 'review-set') { flashcardSession = { setId: target.dataset.setId, index: 0, order: state.sets.find(set => set.id === target.dataset.setId)?.cards.map(card => card.id) || [], flipped: false }; goTo('flashcards'); }
    if (action === 'flip-card') { if (flashcardSession) { flashcardSession.flipped = !flashcardSession.flipped; render(); } }
    if (action === 'all-cards' || action === 'hard-cards') { if (flashcardSession) { flashcardSession.filter = action === 'hard-cards' ? 'hard' : 'all'; flashcardSession.index = 0; flashcardSession.flipped = false; render(); } }
    if (action === 'next-card' || action === 'prev-card') { const set = state.sets.find(item => item.id === flashcardSession?.setId); if (!set) return; const cards = sessionCards(set); const delta = action === 'next-card' ? 1 : -1; flashcardSession.index = cards.length ? (flashcardSession.index + delta + cards.length) % cards.length : 0; flashcardSession.flipped = false; render(); }
    if (action === 'shuffle-cards') shuffleCards();
    if (action.startsWith('rate-card-')) rateCard(action.replace('rate-card-', ''));
    if (action === 'timer-mode') setTimerMode(target.dataset.mode);
    if (action === 'start-timer') startTimer();
    if (action === 'pause-timer') pauseTimer();
    if (action === 'reset-timer') resetTimer();
    if (action === 'finish-timer') finishTimer();
    if (action === 'toggle-task') { const task = state.tasks.find(item => item.id === target.dataset.taskId); if (task) { task.done = target.checked; saveState(); render(); toast(task.done ? 'Tarefa concluída.' : 'Tarefa reaberta.'); } }
    if (action === 'delete-task') { state.tasks = state.tasks.filter(item => item.id !== target.dataset.taskId); saveState(); render(); toast('Tarefa removida.'); }
    if (action === 'delete-subject') { const subject = getSubject(target.dataset.subjectId); if (subject && window.confirm(`Excluir a matéria “${subject.name}”?`)) { state.subjects = state.subjects.filter(item => item.id !== subject.id); saveState(); render(); toast('Matéria removida.'); } }
    if (action === 'join-room') { const card = target.closest('.room-card, .room-shelf-card'); const rooms = state.rooms; const room = rooms.find(item => item.name === card?.querySelector('h3')?.textContent); if (room) { state.activeRoomId = room.id; saveState(); render(); toast('Você entrou na sala local.'); } }
    if (action === 'leave-room') { state.activeRoomId = null; saveState(); render(); toast('Você saiu da sala.'); }
    if (action === 'show-room-list') { const list = $('.focus-room-list'); if (list) { list.hidden = false; list.scrollIntoView({ behavior: 'smooth', block: 'center' }); } }
    if (action === 'refresh-assistant') { render(); toast('Sinais locais atualizados.'); }
    if (action === 'stats-period') { statsPeriod = Number(target.dataset.period) === 30 ? 30 : 7; render(); }
    if (action === 'export-json') exportJSON();
    if (action === 'export-csv') exportCSV();
    if (action === 'import-backup') importBackup();
    if (action === 'clear-data') clearData();
    if (action === 'start-quiz') startQuiz();
    if (action === 'answer-quiz') answerQuiz(target.dataset.answer);
    if (action === 'next-question') nextQuestion();
    if (action === 'exit-quiz') { quizSession = null; render(); }
    if (action === 'close-review') { flashcardSession = null; render(); }
  }

  document.addEventListener('click', handleAction);
  document.addEventListener('submit', event => { event.preventDefault(); handleSubmit(event); });
  document.addEventListener('input', event => {
    if (event.target.id !== 'subjectSearch') return;
    const query = event.target.value.trim().toLowerCase();
    $$('.subject-card').forEach(card => { card.hidden = query && !card.textContent.toLowerCase().includes(query); });
  });
  modalRoot.addEventListener('click', event => { if (event.target === modalRoot) closeModal(); });
  const mobileMenuButton = $('#mobileMenuButton');
  if (mobileMenuButton) mobileMenuButton.addEventListener('click', () => {
    const open = $('#sidebar').classList.toggle('is-open');
    mobileMenuButton.setAttribute('aria-expanded', String(open));
  });
  window.addEventListener('keydown', event => { if (event.key === 'Escape' && modalRoot.getAttribute('aria-hidden') === 'false') closeModal(); });

  updateChrome();
  render();
  if (state.timer.running) startTimerTicker();
})();
